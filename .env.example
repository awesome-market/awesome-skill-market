# OpenAI-compatible local endpoint (omlx)
OMLX_BASE_URL=http://localhost:8001/v1
OMLX_API_KEY=sk-omlx-CHANGE_ME
OMLX_MODEL=Ornith-1.5-35B-A3B-BigBang-MTP-mlx-4bit

# Target GitHub repo (owner/name) used for issue filing + raw image URLs
GITHUB_REPO=owner/awesome-market
GITHUB_BRANCH=main

# Daemon poll interval in minutes
DAEMON_INTERVAL_MIN=30
