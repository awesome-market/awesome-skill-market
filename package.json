{
  "name": "skillmkt",
  "version": "0.5.1",
  "type": "module",
  "description": "Local-first agent skill manager (skillmkt): search, install, audit and merge SKILL.md agent skills for Claude Code, Codex, Cursor, OpenCode, Devin — local web UI, conflict arbitration, version pinning.",
  "author": "terry2010",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terry2010/awesome-market.git"
  },
  "bugs": "https://github.com/terry2010/awesome-market/issues",
  "homepage": "https://github.com/terry2010/awesome-market#readme",
  "keywords": [
    "agent-skills",
    "skill-manager",
    "cli",
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "devin",
    "windsurf",
    "skills-sh",
    "skill-market",
    "skill-audit",
    "supply-chain-security",
    "skill-merge",
    "anti-ai-slop",
    "local-first",
    "llm",
    "coding-agent"
  ],
  "bin": {
    "skillmkt": "client/bin/skillmkt.js"
  },
  "files": [
    "client/",
    "pipeline/lib/",
    "skill/"
  ],
  "scripts": {
    "skillmkt": "node client/bin/skillmkt.js",
    "daemon": "node pipeline/daemon.js",
    "once": "node pipeline/daemon.js --once",
    "sync": "node pipeline/sync.js",
    "extract": "node pipeline/extract.js",
    "merge": "node pipeline/synthesize.js",
    "synthesize": "node pipeline/synthesize.js",
    "evidence": "node pipeline/evidence.js",
    "issues": "node pipeline/issues.js",
    "translate": "node pipeline/translate.js",
    "poll": "node pipeline/poll.js",
    "build": "node pipeline/build.js",
    "decide": "node pipeline/decide.js",
    "validate": "node pipeline/validate.js",
    "setup": "npm install && npx playwright install chromium",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
