{
  "name": "skillmkt",
  "version": "0.4.14",
  "type": "module",
  "description": "Local-first agent skill manager: install, audit, merge, distribute.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/terry2010/awesome-skill-market.git"
  },
  "bugs": "https://github.com/terry2010/awesome-skill-market/issues",
  "homepage": "https://github.com/terry2010/awesome-skill-market#readme",
  "keywords": [
    "agent-skills",
    "skill-manager",
    "claude-code",
    "codex",
    "opencode",
    "devin",
    "skill-audit",
    "skill-merge",
    "anti-ai-slop"
  ],
  "bin": {
    "skillmkt": "client/bin/skillmkt.js"
  },
  "files": [
    "client/",
    "pipeline/lib/",
    "skill/"
  ],
  "scripts": {
    "skillmkt": "node client/bin/skillmkt.js",
    "daemon": "node pipeline/daemon.js",
    "once": "node pipeline/daemon.js --once",
    "sync": "node pipeline/sync.js",
    "extract": "node pipeline/extract.js",
    "merge": "node pipeline/synthesize.js",
    "synthesize": "node pipeline/synthesize.js",
    "evidence": "node pipeline/evidence.js",
    "issues": "node pipeline/issues.js",
    "translate": "node pipeline/translate.js",
    "poll": "node pipeline/poll.js",
    "build": "node pipeline/build.js",
    "decide": "node pipeline/decide.js",
    "validate": "node pipeline/validate.js",
    "setup": "npm install && npx playwright install chromium",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
